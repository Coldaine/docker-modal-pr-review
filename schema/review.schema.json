{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["head_sha", "complete", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "head_sha": {
      "type": "string",
      "minLength": 7,
      "description": "The exact reviewed git commit SHA"
    },
    "complete": {
      "type": "boolean",
      "const": true,
      "description": "Must be true. Incomplete reviews are rejected."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Executive summary of what was inspected and overall conclusions"
    },
    "findings": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["severity", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "path": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
